<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LauncherTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/launcher_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:colorAccent">@color/launcher_accent</item>
        <item name="android:textColorLink">@color/launcher_accent</item>
    </style>
</resources>
